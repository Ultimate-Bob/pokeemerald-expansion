mapscripts LilycoveCity_LilycoveMuseum_Exterior_MapScripts {

}

script MysteryGiftGirl_GiveItems {
    lock
    setflag(FLAG_ENABLE_SHIP_SOUTHERN_ISLAND)
    setflag(FLAG_ENABLE_SHIP_BIRTH_ISLAND)
    setflag(FLAG_ENABLE_SHIP_NAVEL_ROCK)
    setflag(FLAG_ENABLE_SHIP_FARAWAY_ISLAND)
    if (!flag(FLAG_LILYCOVE_MYSTERYGIFT_GIRL_SPOKEN)) {
        setflag(FLAG_LILYCOVE_MYSTERYGIFT_GIRL_SPOKEN)
        msgbox(format("............\p"
        "I was born in a very distant land.\p"
        "I have travelled to wonderous places and seen many beautiful things.\p"
        "And then I came to the HOENN region...\N"
        "I feel this is the place I truly belong...\p"
        "No matter how far I travel - sea, land or sky, it always leads back here."), MSGBOX_SIGN)
        closemessage
        playse(SE_M_ICY_WIND)
        waitse
        msgbox(format("Feel that coastal breeze...{PAUSE 60}\n"
        "it's pleasant isn't it?"), MSGBOX_SIGN)
        msgbox(format("Thank you for listening to me.\p"
        "I've come across a couple of curiosities in my travels that you might find interesting.\N
        Perhaps you'd like to take a look?"), MSGBOX_NPC)
        waitmessage
        pokemart(MysteryGiftGirl_Items)
    }
    else {
        msgbox(format("Oh hello again. Interested in my curious items?"), MSGBOX_NPC)
        waitmessage
        pokemart(MysteryGiftGirl_Items)
    }
    
    release
}

mart MysteryGiftGirl_Items {
    ITEM_MYSTIC_TICKET
    ITEM_EON_TICKET
    ITEM_AURORA_TICKET
    ITEM_OLD_SEA_MAP
    ITEM_ENIGMA_BERRY
}

script LilycoveLookout_Sign {
    msgbox(format("{UP_ARROW} LILYCOVE LOOKOUT"), MSGBOX_SIGN)
}