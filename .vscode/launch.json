{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/pokeemerald.elf",
            "cwd": "${workspaceRoot}",
            "environment": [],
            "externalConsole": false,
            "miDebuggerServerAddress": "localhost:2345",
            "MIMode": "gdb",
            "miDebuggerPath": "arm-none-eabi-gdb",
            "debugServerPath": "${workspaceRoot}/start-mgba.sh",
            "debugServerArgs": "${workspaceRoot}/pokeemerald.elf",
            "serverStarted": "started",
            "preLaunchTask": "${defaultBuildTask}",
            "logging": {
                "moduleLoad": true,
                "trace": true,
                "engineLogging": true,
                "programOutput": true,
                "exceptions": true
            },
        },
    ]
}